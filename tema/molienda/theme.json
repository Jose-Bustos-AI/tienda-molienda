{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "name": "Crema", "slug": "base", "color": "#f4ede3" },
				{ "name": "Espresso", "slug": "contrast", "color": "#2a1d16" },
				{ "name": "Terracota", "slug": "accent-1", "color": "#c4572e" },
				{ "name": "Crema tostada", "slug": "accent-2", "color": "#ebe0d0" },
				{ "name": "Tostado", "slug": "accent-3", "color": "#8a5a3b" },
				{ "name": "Gris cálido", "slug": "accent-4", "color": "#6f625a" },
				{ "name": "Blanco roto", "slug": "accent-5", "color": "#fffaf3" },
				{ "name": "Verde cafetal", "slug": "accent-6", "color": "#3f5a43" }
			]
		},
		"layout": { "contentSize": "760px", "wideSize": "1240px" },
		"typography": {
			"fontFamilies": [
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope.woff2" ] }
					]
				},
				{
					"name": "Fraunces",
					"slug": "fraunces",
					"fontFamily": "Fraunces, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces.woff2" ] },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "300 800", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces-italic.woff2" ] }
					]
				}
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
		"typography": { "fontFamily": "var:preset|font-family|manrope", "fontSize": "17px", "lineHeight": "1.6", "fontWeight": "400" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|fraunces", "fontWeight": "500", "letterSpacing": "-0.02em", "lineHeight": "1.08" },
				"color": { "text": "var:preset|color|contrast" }
			},
			"link": {
				"color": { "text": "var:preset|color|contrast" },
				":hover": { "color": { "text": "var:preset|color|accent-1" } }
			},
			"button": {
				"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|accent-5" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var:preset|font-family|manrope", "fontWeight": "700", "fontSize": "15px" },
				"spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "26px", "right": "26px" } },
				":hover": { "color": { "background": "var:preset|color|accent-1", "text": "var:preset|color|accent-5" } }
			}
		}
	}
}
